# ==============================================================================
# Environment Configuration Template
# Duplicate this file as .env and populate your actual private credentials.
# NOTE: Never commit your real .env file with sensitive API keys to Git.
# ==============================================================================

# Server configuration
PORT=5000
NODE_ENV=development

# LLM API Configuration (Kept strictly on the backend)
GEMINI_API_KEY=your_api_key_here

# Frontend API Endpoint (Optional: configured in Vite proxy or direct URL)
VITE_API_BASE_URL=http://localhost:5000/api
